    { "id": "3333333333330001", "type": "text", "x": 0, "y": 10, "width": 260, "height": 110, "color": "4", "text": "## 1 · Discover & Plan\nFind RUNNING campaigns, demand and live coupons in your niche." },
    { "id": "3333333333330002", "type": "text", "x": 340, "y": 10, "width": 260, "height": 110, "color": "4", "text": "## 2 · Generate Links\nMint attributed tracking links; stamp a stable `sub1`." },
    { "id": "3333333333330003", "type": "text", "x": 680, "y": 10, "width": 260, "height": 110, "color": "4", "text": "## 3 · Publish\nContent + clear disclosure + coupon CTA." },
    { "id": "3333333333330004", "type": "text", "x": 1020, "y": 10, "width": 260, "height": 110, "color": "4", "text": "## 4 · Track & Convert\nClicks → conversions; pending → approved/rejected." },
    { "id": "3333333333330005", "type": "text", "x": 1360, "y": 10, "width": 260, "height": 110, "color": "4", "text": "## 5 · Report & Optimize\nEPC by `sub1`, daily digest, refine the plan." },

