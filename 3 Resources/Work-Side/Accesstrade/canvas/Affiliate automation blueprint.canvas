    { "id": "1111111111111111", "type": "text", "x": -60, "y": -150, "width": 640, "height": 80, "color": "4", "text": "# Affiliate Automation Blueprint\nClaude × Accesstrade — discover → link → publish → convert → optimize" },
    { "id": "1111111111111113", "type": "text", "x": 600, "y": -150, "width": 420, "height": 80, "color": "2", "text": "## ↻ The loop repeats\nReport feeds the next Discover — content compounds." },
    { "id": "1111111111111112", "type": "file", "x": 1040, "y": -150, "width": 360, "height": 90, "file": "Affiliate/API Integration/Accesstrade API Integration - MOC.md" },

